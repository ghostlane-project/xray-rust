+    /// A frame larger than SETTINGS_MAX_FRAME_SIZE is a connection error of
+    /// type FRAME_SIZE_ERROR, read from its header alone; then the stream ends.
+    #[test]
+    fn a_frame_above_the_maximum_is_a_frame_size_error() {
