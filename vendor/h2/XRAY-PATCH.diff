+        let mut buf: Buffer<[u8; 200]> = Buffer::new();
+        let mut deque = Deque::new();
+        for _ in 0..512 {
+            deque.push_back(&mut buf, [0; 200]);
+        }
+        while deque.pop_front(&mut buf).is_some() {}
+        assert!(buf.is_empty());
