+/// XRAY-PATCH: `red` on a video line is a payload type of its own (see
+/// XRAY-PATCH.md, "Video RED is a payload type of its own").
+mod video {
+    use std::net::Ipv4Addr;
+    use std::time::Duration;
+
+    use netem::{NetemConfig, Probability, RandomLoss};
+    use str0m::format::{Codec, FormatParams};
+    use str0m::media::{Direction, Frequency, MediaKind, Mid};
+    use str0m::rtp::{RtpWrite, SeqNo};
+    use str0m::{Event, RtcError};
+
+    use super::common::{Peer, TestRtc, init_crypto_default, init_log, negotiate, progress};
+
+    /// The payload types the offering end is built with: a camera's video
+    /// forwarded in RED and that stream's RTX. The answering end starts with
+    /// other numbers and must end with these.
+    const RED: u8 = 104;
+    const RED_RTX: u8 = 105;
+
+    fn rtc(peer: Peer, rtp_mode: bool, red: u8, rtx: u8) -> TestRtc {
+        TestRtc::new_with_config(peer, |c| {
+            let mut c = c.set_rtp_mode(rtp_mode);
+            c.codec_config().add_config(
+                red.into(),
+                Some(rtx.into()),
+                Codec::Red,
+                Frequency::NINETY_KHZ,
+                None,
+                FormatParams::default(),
+            );
+            c
+        })
+    }
+
+    /// `l` (RTP mode) offers one video line both ways to `r`; returns both once
+    /// connected, and the line.
+    fn connect(receiver_rtp_mode: bool) -> (TestRtc, TestRtc, Mid) {
+        init_log();
+        init_crypto_default();
+        let mut l = rtc(Peer::Left, true, RED, RED_RTX);
+        let mut r = rtc(Peer::Right, receiver_rtp_mode, 110, 111);
+        l.add_host_candidate((Ipv4Addr::new(1, 1, 1, 1), 1000).into());
+        r.add_host_candidate((Ipv4Addr::new(2, 2, 2, 2), 2000).into());
+        let mid = negotiate(&mut l, &mut r, |change| {
+            change.add_media(MediaKind::Video, Direction::SendRecv, None, None, None)
+        });
+        loop {
+            if l.is_connected() || r.is_connected() {
+                break;
+            }
+            progress(&mut l, &mut r).unwrap();
+        }
+        let now = l.last.max(r.last);
+        l.last = now;
+        r.last = now;
+        (l, r, mid)
+    }
+
+    /// RFC 2198 with the primary block alone: one byte naming the wrapped
+    /// payload type, then that payload.
+    fn red_payload(seq: u64) -> Vec<u8> {
+        vec![96, 0x90, 0x80, seq as u8, 7, 7, 7]
+    }
+
+    fn write(l: &mut TestRtc, mid: Mid, seq: u64) {
+        let now = l.last;
+        l.direct_api()
+            .stream_tx_by_mid(mid, None)
+            .expect("the line's send stream")
+            .write_rtp(
+                RtpWrite::new(RED.into(), seq.into(), seq as u32 * 3000, now, red_payload(seq))
+                    .nackable(true),
+            );
+    }
+
+    fn red_packets(r: &TestRtc) -> Vec<(SeqNo, Vec<u8>)> {
+        r.events
+            .iter()
+            .filter_map(|(_, e)| match e {
+                Event::RtpPacket(p) if *p.header.payload_type == RED => {
+                    Some((p.seq_no, p.payload.to_vec()))
+                }
+                _ => None,
+            })
+            .collect()
+    }
