+                .find(|p| p.spec().codec == Codec::Red)
+                .expect("red in the payload table");
+            assert_eq!((*red.pt(), red.resend().map(|pt| *pt)), (RED, Some(RED_RTX)));
+            let line = rtc.media(mid).expect("the video line");
+            assert!(
+                line.remote_pts().contains(&RED.into()),
+                "the line's remote payload types: {:?}",
+                line.remote_pts()
+            );
+        }
+        for seq in 1000..1020 {
+            write(&mut l, mid, seq);
+            progress(&mut l, &mut r)?;
+        }
+        let until = l.duration() + Duration::from_millis(500);
+        while l.duration() < until {
+            progress(&mut l, &mut r)?;
+        }
+        let got = red_packets(&r);
+        let want: Vec<_> = (1000..1020u64)
+            .map(|seq| (SeqNo::from(seq), red_payload(seq)))
+            .collect();
+        assert_eq!(got, want);
+        Ok(())
+    }
+
+    /// A lost RED packet comes again on the RTX stream its payload type names
+    /// and is handed up as the packet it was.
+    #[test]
+    fn a_lost_video_red_packet_is_resent_over_its_rtx() -> Result<(), RtcError> {
+        let (mut l, mut r, mid) = connect(true);
+        for seq in 1000..1030u64 {
+            let loss = if seq == 1010 { 1.0 } else { 0.0 };
+            r.set_netem(NetemConfig::new().loss(RandomLoss::new(Probability::new(loss))));
+            write(&mut l, mid, seq);
+            progress(&mut l, &mut r)?;
+        }
+        r.set_netem(NetemConfig::new());
+        let lost = SeqNo::from(1010u64);
+        let deadline = l.duration() + Duration::from_secs(3);
+        while !red_packets(&r).iter().any(|(seq, _)| *seq == lost) {
+            assert!(l.duration() < deadline, "the lost packet must arrive again");
+            progress(&mut l, &mut r)?;
+        }
+        let got = red_packets(&r);
+        let again = got.iter().find(|(seq, _)| *seq == lost).unwrap();
+        assert_eq!(again.1, red_payload(1010));
+        assert_eq!(got.len(), 30, "each packet once");
+        Ok(())
+    }
+
+    /// A frame-mode receiver has no depacketizer for `red`: the packets are
+    /// dropped, as they were before `red` had parameters, and nothing panics.
+    #[test]
+    fn a_frame_mode_receiver_drops_video_red() -> Result<(), RtcError> {
+        let (mut l, mut r, mid) = connect(false);
+        for seq in 1000..1010 {
+            write(&mut l, mid, seq);
+            progress(&mut l, &mut r)?;
+        }
+        let until = l.duration() + Duration::from_millis(500);
+        while l.duration() < until {
+            progress(&mut l, &mut r)?;
+        }
+        assert!(
+            !r.events
+                .iter()
+                .any(|(_, e)| matches!(e, Event::MediaData(_) | Event::RtpPacket(_))),
+            "a frame-mode receiver handed RED up"
+        );
+        Ok(())
+    }
+}
