@@ -889,3 +889,30 @@
     );
     Ok(())
 }
+
+/// XRAY-PATCH: VK Calls' SFU answers an INIT naming Supported Extensions with
+/// an INIT ACK carrying an Unrecognized Parameter (type 8) and the State
+/// Cookie; the chunk is read and the cookie found.
+#[test]
+fn test_init_ack_with_an_unrecognized_parameter() -> Result<()> {
+    let mut raw: Vec<u8> = vec![
+        0x02, 0x00, 0x00, 0x2c, // INIT ACK, length 44
+        0x58, 0xf1, 0xa5, 0x8f, // initiate tag
+        0x00, 0x01, 0x90, 0x00, // a_rwnd
+        0xff, 0xff, 0xff, 0xff, // streams
+        0x7f, 0x64, 0xbf, 0x05, // initial TSN
+        0x00, 0x08, 0x00, 0x0a, 0x80, 0x08, 0x00, 0x06, 0x82, 0xc0, 0x00, 0x00, // unrecognized: supported extensions
+        0x00, 0x07, 0x00, 0x0c, // state cookie, 8 bytes
+    ];
+    raw.extend_from_slice(b"cookie-1");
+    let c = ChunkInit::unmarshal(&Bytes::from(raw))?;
+    assert!(c.is_ack);
+    assert_eq!(c.params.len(), 2);
+    let cookie = c
+        .params
+        .iter()
+        .find_map(|p| p.as_any().downcast_ref::<crate::param::param_state_cookie::ParamStateCookie>())
+        .expect("the cookie is read");
+    assert_eq!(&cookie.cookie[..], b"cookie-1");
+    Ok(())
+}
